# Shopify Storefront API Configuration
# Get these from your Shopify Admin: Settings > Apps and sales channels > Develop apps

# Your Shopify store domain (e.g., your-store.myshopify.com)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token (starts with shpat_)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here

# Storefront API version (e.g., 2024-01)
NEXT_PUBLIC_SHOPIFY_API_VERSION=2024-01

# Optional: Enable mock data mode for development without Shopify
# Set to 'true' to use mock data, 'false' to use Shopify API
NEXT_PUBLIC_USE_MOCK_DATA=false
